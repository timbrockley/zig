#!/bin/bash
#--------------------------------------------------------------------------------
if [ "${1}" == "cache" ] || [ "${2}" == "cache" ]
then
	#--------------------------------------------------------------------------------
	test -d ~/.cache/zig && rm -rf ~/.cache/zig
	#--------------------------------------------------------------------------------
fi
#--------------------------------------------------------------------------------
if [ "${1}" == "all" ] || [ "${2}" == "all" ]
then
	#--------------------------------------------------------------------------------
	find /www/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	#--------------------------------------------------------------------------------
else
	#--------------------------------------------------------------------------------
	test -d /www/c && find /www/c/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	test -d /www/wasm && find /www/wasm/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	test -d /www/zig && find /www/zig/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	test -d /www/zig015 && find /www/zig015/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	test -d /www/zig016 && find /www/zig016/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	test -d /www/zig017 && find /www/zig017/ -type d \( -name ".zig-cache" -o -name ".zig-out" -o -name ".zig-pkg" -o -name "zig-cache" -o -name "zig-out" -o -name "zig-pkg" \) -exec echo "rm -rf {}" \; -exec rm -rf {} +
	#--------------------------------------------------------------------------------
fi
#--------------------------------------------------------------------------------